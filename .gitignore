
# ==========================================================
# MeChat — .gitignore
# ASP.NET Core Web API (.NET 10) + React/Vite + SQL Server
# ==========================================================

# ----------------------------------------------------------
# .NET / Visual Studio / Rider
# ----------------------------------------------------------
**/bin/
**/obj/
.vs/
.idea/
_ReSharper*/
*.suo
*.user
*.userosscache
*.sln.docstates

# ----------------------------------------------------------
# Node.js / React / Vite
# ----------------------------------------------------------
**/node_modules/
**/dist/
**/.vite/
**/.cache/
**/.turbo/
**/.parcel-cache/
*.tsbuildinfo

# ----------------------------------------------------------
# Environment variables / Secrets
# ----------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

**/appsettings.Development.json
**/appsettings.Production.json
**/appsettings.Local.json
**/secrets.json
**/*secrets*.local.json

# Certificates and sensitive keys
*.pfx
*.p12
*.pem
*.key
*.snk

# ----------------------------------------------------------
# Local uploads / Development Mail
# ----------------------------------------------------------
# Product Owner workbook contains private screenshots. Keep the original local.
docs/frontend/MeChat_Danh_sach_cai_thien_va_kiem_thu_v1.xlsx
**/private-uploads/
**/dev-mail/
**/uploads/
**/temp-uploads/

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
*.bak
*.bacpac
*.mdf
*.ndf
*.ldf
*.sqlite
*.sqlite3
*.db

# ----------------------------------------------------------
# Tests / Playwright / Coverage
# ----------------------------------------------------------
**/test-results/
**/playwright-report/
**/blob-report/
**/coverage/
**/.nyc_output/
**/.auth/
**/playwright/.auth/

# Automatically generated screenshot artifacts
**/screenshots/vi/
**/screenshots/hybrid-before/
**/screenshots/hybrid-after/
**/screenshots/hybrid-states/

# Keep manually selected documentation images
!docs/frontend/assets/

# ----------------------------------------------------------
# Logs / Temporary Files
# ----------------------------------------------------------
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.swp
*.swo
*.bak.tmp
__pycache__/
*.py[cod]

# ----------------------------------------------------------
# OS
# ----------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------------------------------------
# IDE / Local configuration
# ----------------------------------------------------------
.vscode/*.local.json
.vscode/settings.local.json

# ----------------------------------------------------------
# Local test credentials / Sessions
# ----------------------------------------------------------
**/storageState.json
**/storage-state.json
**/auth-state.json
**/cookies.json

# Local build outputs from isolated G2 checks
.artifacts/

