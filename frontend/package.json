{
  "name": "mechat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint . --max-warnings=0",
    "audit:localization": "node scripts/audit-localization.mjs",
    "audit:api": "node scripts/audit-api-consumers.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.js",
    "test:e2e:production": "playwright test --config playwright.production.config.js",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "latest",
    "@hookform/resolvers": "latest",
    "@microsoft/signalr": "^10.0.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.7.2",
    "lucide-react": "latest",
    "radix-ui": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-i18next": "^17.1.13",
    "react-router": "^7.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "latest",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
